/// Per-user LLM provider and model configuration.
/// Supports default provider + optional per-tier (mini/normal/advanced) overrides
/// for mixing providers across tiers.
///
/// @description Stores the user's chosen LLM provider configuration including
/// default provider, per-tier provider overrides, per-tier model overrides,
/// and encrypted API keys for each provider.
///
/// TYPESTRING.SKIP=true
model LlmConfiguration {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  /// Relation to the User model. GQL.SKIP=true
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Default provider used for all tiers unless overridden
  defaultProvider LlmProvider @default(OPENAI)

  /// Per-tier provider overrides (null = inherit from defaultProvider)
  miniProvider     LlmProvider?
  normalProvider   LlmProvider?
  advancedProvider LlmProvider?

  /// Per-tier model overrides (null = use provider's default for that tier).
  /// These are model ID strings. The canonical sets are documented by the per-provider enums
  /// (OpenaiModel, AnthropicModel, DeepseekModel, KimiModel, QwenModel, XaiModel, GeminiModel,
  /// DeepinfraModel)
  /// — e.g. "gpt-5.5", "claude-opus-4-7", "deepseek-v4-pro", "grok-4.3", "gemini-3.1-pro-preview",
  /// "deepseek-ai/DeepSeek-V4-Pro". The column is free text precisely so a host whose ids carry
  /// "/" and mixed case needs no schema change to be nameable.
  miniModel     String?
  normalModel   String?
  advancedModel String?

  /// Provider API keys (encrypted at rest). TYPESTRING.SKIP=true GQL.SKIP=true
  openaiApiKey    String?
  /// TYPESTRING.SKIP=true GQL.SKIP=true
  anthropicApiKey String?
  /// TYPESTRING.SKIP=true GQL.SKIP=true
  deepseekApiKey  String?
  /// TYPESTRING.SKIP=true GQL.SKIP=true
  kimiApiKey      String?
  /// TYPESTRING.SKIP=true GQL.SKIP=true
  qwenApiKey      String?
  /// TYPESTRING.SKIP=true GQL.SKIP=true
  xaiApiKey       String?
  /// TYPESTRING.SKIP=true GQL.SKIP=true
  geminiApiKey    String?
  /// TYPESTRING.SKIP=true GQL.SKIP=true
  deepinfraApiKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

