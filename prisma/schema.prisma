  signal TradeSignal @default(PRICE_ACTION)

  /// Strategy used to execute the trade.
  strategy TradeStrategy @default(TECHNICAL_ANALYSIS)

  /// Analysis supporting the trade decision as markdown text. TYPESTRING.SKIP=true
  analysis String

  /// summary of the trade decision (this should be a short description of the trade).
  summary String

  /// Confidence level in the trade decision.
  confidence Float

  /// Timestamp when the trade was executed. TYPESTRING.SKIP=true
  timestamp DateTime?

  /// Timestamp when the trade record was created. TYPESTRING.SKIP=true
  createdAt DateTime @default(now())

  /// Timestamp when the trade record was last updated. TYPESTRING.SKIP=true
  updatedAt DateTime @updatedAt

  /// Current status of the trade.
  status TradeStatus @default(PENDING)

  /// Timestamp when the trade was soft-deleted. Null means the record is active. TYPESTRING.SKIP=true
  deletedAt DateTime?

  /// The symbol of the asset associated with this trade.
  symbol String

  /// Wave F — Derived position direction for this trade's persistent per-name thesis (the NameThesis home). NULL until the thesis is formed/backfilled; nothing reads it yet — consumers switch shadow-first later. Set explicitly at trade creation from the derived directional call — NOT re-derived from Action.type BUY/SELL, which is order-verb-ambiguous (BUY = open-long | cover-short; SELL = close-long | open-short).
  side TradeSide?

  /// List of actions associated with this trade. TYPESTRING.INCLUDE=["id","sequence","type","note","status", "order"] GQL.EXCLUDE=['trade']
  actions Action[]

  /// Entry price for the trade (average of all entry orders). TYPESTRING.SKIP=true
  entryPrice Float?

  /// Exit price for the trade (average of all exit orders). TYPESTRING.SKIP=true
  exitPrice Float?

  /// Quantity of shares/units entered. TYPESTRING.SKIP=true
  entryQty Float?

  /// Quantity of shares/units exited. TYPESTRING.SKIP=true
  exitQty Float?

  /// Total entry value (price * quantity). TYPESTRING.SKIP=true
  entryValue Float?

  /// Total exit value (price * quantity). TYPESTRING.SKIP=true
  exitValue Float?

  /// When the position was entered. TYPESTRING.SKIP=true
  entryTime DateTime?

  /// When the position was exited (null if still open). TYPESTRING.SKIP=true
  exitTime DateTime?

  /// Profit/loss amount in currency. TYPESTRING.SKIP=true
  pnlAmount Float?

  /// Profit/loss as a percentage. TYPESTRING.SKIP=true
  pnlPercent Float?

  /// Duration of the trade in minutes. TYPESTRING.SKIP=true
  durationMinutes Float?

  /// Market phase when the trade was entered. TYPESTRING.SKIP=true
  marketPhase String?

  /// Market volatility when the trade was entered. TYPESTRING.SKIP=true
  marketVolatility String?

  /// Session Horizon (i.e. the forecasted time horizon for the trade). TYPESTRING.SKIP=true
  sessionHorizonMinutes Int?

  /// Thresholds used for this trade as JSON. TYPESTRING.SKIP=true
  thresholdsJson String? @map("thresholds")

  /// Version number of the trade thesis, incremented on each re-underwriting.
  thesisVersion Int @default(1)

  /// Timestamp of the last re-underwriting evaluation for this trade. TYPESTRING.SKIP=true
  lastReunderwrittenAt DateTime?

  /// If this trade was superseded, references the replacement trade's ID. TYPESTRING.SKIP=true
  supersededById String? @db.Uuid

  /// Forensic metadata populated when status is REJECTED_BROKER, REJECTED_COMPLIANCE, or FAILED. Carries reason, errorCode, brokerResponse, attemptedAt and any other contextual details required for SEC Rule 15c3-5 audits and FINRA review. Null for trades that did not fail or get rejected.
  rejectionMetadata Json?

  /// Wave 234 — Upstream ensemble signal source that produced this trade. One of "ensemble" | "llm_only" | "transformer_only" | "drift_fallback" | "manual". Populated at trade creation from `TradeSideAndSignal.metadata.signalSource`. Consumed at exit-fill time to populate `TradeOutcome.signalSource` (replacing the legacy hardcoded "ensemble" default in `order-fill-handler.ts:labelExitOutcomeFromFill`). Calibration trainer joins on this for cohort partition.
  signalSource String?

  /// Wave F — Typed mirror of `signalSource` (dual-write). NULL until backfilled from the paired String by mapping known members (case-normalised); unmappable values stay NULL — unknown stays unknown, never defaulted to a member. Retained alongside the String until a later coordinated change drops the String. TYPESTRING.SKIP=true
  signalSourceType TradeSignalSource?

  /// Wave 234 — Unique signal identifier (UUID, cuid-style) from the upstream TradeSignalEvent. Threaded end-to-end so live-IC computation can correlate (signal_score, forward_return) on a one-to-one basis. Joined to `PredictionPair.tradeId` (which Wave 213 populated with `signal.signalId`) at calibration training time. TYPESTRING.SKIP=true
  signalId String?

  /// Wave 234 — Decision pathway as a free-form string (matches the ML system DecisionPathway enum: ML_ONLY | LLM_ONLY | HYBRID | FALLBACK | RULES | UNKNOWN). Carried separately from signalSource to support richer attribution analytics: signalSource describes which producer emitted the merged signal; pathway describes the high-level decision pathway (the typed system enum). TYPESTRING.SKIP=true
  pathway String?

  /// Wave F — Typed mirror of `pathway` (dual-write). NULL until backfilled from the paired String; unmappable values stay NULL. Retained alongside the String until a later coordinated change drops the String. TYPESTRING.SKIP=true
  pathwayType DecisionPathway?

  /// Wave 236 — Exit tier classification (TIER_A | TIER_B | TIER_C | MANUAL | EOD) for exit trades. NULL on open trades. Populated when the exit is initiated by the exit-framework orchestrator (Tier A = volatility/regime circuit breakers; Tier B = engine-internal stop logic; Tier C = LLM advisory re-evaluation). Refines `TradeOutcome.exitReason` (which is derived from order shape) with the upstream decision tier. TYPESTRING.SKIP=true
  exitTier String?

  /// Wave F — Typed mirror of `exitTier` (dual-write). NULL on open trades and until backfilled from the paired String; unmappable values stay NULL. Retained alongside the String until a later coordinated change drops the String. TYPESTRING.SKIP=true
  exitTierType ExitTier?

  /// Stage 2 — Foreign key referencing the owning Strategy entity. NULL means the trade has NOT been attributed to a registered strategy; it is deliberately nullable and deliberately unbackfilled, so no historical row acquires a fabricated owner. Additive alongside the legacy `strategy` enum, which is NOT removed — migrating off `TradeStrategy` is a later stage. TYPESTRING.SKIP=true
  strategyId String? @db.Uuid

  /// Relation to the owning Strategy. Kept out of the generated selection sets (GQL.SKIP) so adding it does not widen every existing Trade query; consumers join on `strategyId`. TYPESTRING.SKIP=true GQL.SKIP=true
  strategyRef Strategy? @relation(fields: [strategyId], references: [id], onDelete: Restrict)

  @@index([strategyId])
  @@index([alpacaAccountId])
  @@index([alpacaAccountId, status])
  @@index([symbol])
  @@index([updatedAt])
  @@index([signalId])
  @@map(name: "trades")
}

