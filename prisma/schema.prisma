// Manages A/B testing for model deployments.
model ABTest {
  /// Unique identifier for the A/B test. TYPESTRING.SKIP=true
  id String @id @default(uuid()) @db.Uuid

  /// Name of the A/B test.
  name String

  /// Description of what the A/B test is measuring.
  description String

