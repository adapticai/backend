// ---------------------------------------------------------------------------
// Risk-governance enums (Phase B — P0 institutional-risk-protection)
// ---------------------------------------------------------------------------

/// Operational state of a trading account from the risk-governance perspective.
enum AccountRiskState {
  NORMAL
  WARN
  THROTTLE
  PAUSED
  FLATTEN
  HALT
}

/// Operational state of an individual trading strategy from the risk-governance perspective.
enum StrategyState {
  ACTIVE
  WARN
  THROTTLE
  PAUSED
  DISABLED
}

/// Reason codes that trigger a risk escalation event.
enum RiskEscalationReason {
  // Drawdown
  DRAWDOWN_WARN
  DRAWDOWN_THROTTLE
  DRAWDOWN_PAUSE
  // Loss windows
  DAILY_LOSS_BREACH
  WEEKLY_LOSS_BREACH
  MONTHLY_LOSS_BREACH
  PEAK_TO_TROUGH_BREACH
  // Broker
  BROKER_FAILURE_RATE
  BROKER_LATENCY_SPIKE
  BROKER_OUTAGE
  // Data
  DATA_QUALITY_STALE
  DATA_QUALITY_MISSING
  DATA_QUALITY_FEED_FAIL
  // Concentration
  CONCENTRATION_POSITION
  CONCENTRATION_SECTOR
  CONCENTRATION_FACTOR
  // Volatility / regime
  VOLATILITY_SPIKE
  REGIME_CRISIS
  REGIME_UNCERTAIN
  // Strategy / model
  STRATEGY_DRAWDOWN
  STRATEGY_EXPECTANCY_DEGRADATION
  STRATEGY_HIT_RATE_DEGRADATION
  LIVE_VS_BACKTEST_DIVERGENCE
  MODEL_CONFIDENCE_COLLAPSE
  MODEL_DRIFT_DETECTED
  // Operator / manual
  OPERATOR_OVERRIDE
  OPERATOR_RECOVERY
  OPERATOR_CLEAR
  // System
  SCHEDULED_MAINTENANCE
  EMERGENCY_HALT
  /// System-driven auto-recovery from a halted/throttled FSM state once the
  /// cooldown window has elapsed AND the consecutive-clear-sample threshold
  /// has been observed. Distinguished from `OPERATOR_RECOVERY` (operator
  /// manually un-halted a scope) for audit-trail / regulatory clarity:
  /// regulators differentiate between human-discretionary recoveries and
  /// machine-deterministic recoveries.
  /// Emitted by `engine/src/services/risk/governance/recovery-coordinator.ts`
  /// `_fireRecovery()` / `_fireAiEvaluatedRecovery()`.
  AUTOMATED_RECOVERY
}

/// Actor that initiated a risk escalation event.
enum RiskEscalationActor {
  SYSTEM_OBSERVER
  OPERATOR
  COMPLIANCE_OFFICER
  AUTOMATED_RECOVERY
}

/// Per-account risk metrics snapshot: FSM state, high-water mark, drawdown, and D/W/M P&L windows.
model AccountRiskMetrics {
  id                       String   @id @default(uuid()) @db.Uuid
  alpacaAccountId          String   @unique @db.Uuid
  alpacaAccount            AlpacaAccount @relation(fields: [alpacaAccountId], references: [id], onDelete: Cascade)

  currentRiskState         AccountRiskState @default(NORMAL)
  currentScopeState        Json?    // map of scope (asset_class, strategy, symbol) -> state
  riskStateChangedAt       DateTime?
  riskStateChangedBy       String?
  riskStateChangeReason    String?

  accountHighWaterMark     Decimal? @db.Decimal(20, 2)
  accountHighWaterMarkAt   DateTime?
  currentEquity            Decimal? @db.Decimal(20, 2)
  currentDrawdownPct       Decimal? @db.Decimal(10, 6)
  intradayDrawdownPct      Decimal? @db.Decimal(10, 6)
  maxDrawdownPctLifetime   Decimal? @db.Decimal(10, 6)

  dailyPnlAmount           Decimal? @db.Decimal(20, 2)
  dailyPnlPct              Decimal? @db.Decimal(10, 6)
  weeklyPnlAmount          Decimal? @db.Decimal(20, 2)
  weeklyPnlPct             Decimal? @db.Decimal(10, 6)
  monthlyPnlAmount         Decimal? @db.Decimal(20, 2)
  monthlyPnlPct            Decimal? @db.Decimal(10, 6)
  peakToTroughAmount       Decimal? @db.Decimal(20, 2)
  peakToTroughPct          Decimal? @db.Decimal(10, 6)

  nextRecoveryEligibleAt   DateTime?
  lastSyncedAt             DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([alpacaAccountId])
  @@index([currentRiskState, riskStateChangedAt])
}

/// Per-strategy rolling-window health snapshot: FSM state, rolling stats, backtest divergence, and confidence trend.
model StrategyHealthSnapshot {
  id                       String   @id @default(uuid()) @db.Uuid
  alpacaAccountId          String   @db.Uuid
  alpacaAccount            AlpacaAccount @relation(fields: [alpacaAccountId], references: [id], onDelete: Cascade)
  /// Registered strategy KEY — the same value space as `Strategy.key` and the
  /// engine Tier A `StrategyRegistryEntry.key` (e.g. "core-equity-llm-v1").
  ///
  /// Stage 2 repoints this column. Rows written before Stage 2 carry an
  /// upstream ENSEMBLE SIGNAL SOURCE ("ensemble" | "llm_only" | "manual" |
  /// "transformer_only" | "drift_fallback") — a description of which producer
  /// emitted the signal, which is NOT a strategy. Those rows are left in place
  /// rather than rewritten (nothing can establish which strategy they belonged
  /// to), so a consumer that needs "strategies" must reject keys that are not
  /// registered `Strategy.key` values rather than assume every distinct value
  /// here names one.
  strategyName             String

  currentState             StrategyState @default(ACTIVE)
  stateChangedAt           DateTime?
  stateChangedReason       String?

  windowSize               Int      @default(20)
  windowTradeCount         Int      @default(0)
  windowHitRate            Decimal? @db.Decimal(10, 6)
  windowExpectancy         Decimal? @db.Decimal(20, 6)
  windowProfitFactor       Decimal? @db.Decimal(20, 6)
  windowSortino            Decimal? @db.Decimal(20, 6)
  windowMaxDrawdownPct     Decimal? @db.Decimal(10, 6)
  windowCumulativePnlAmt   Decimal? @db.Decimal(20, 2)

  backtestExpectancy       Decimal? @db.Decimal(20, 6)
  backtestHitRate          Float?
  backtestHitRateStdDev    Float?
  backtestExpectancyStdDev Float?
  divergenceZScore         Decimal? @db.Decimal(10, 6)
  divergenceAlertActive    Boolean  @default(false)

  averageConfidence        Decimal? @db.Decimal(10, 6)
  confidenceTrend          Decimal? @db.Decimal(10, 6)

  lastUpdatedAt            DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([alpacaAccountId, strategyName])
  @@index([currentState])
  @@index([alpacaAccountId, currentState])
}

/// Immutable audit record of every risk FSM state transition, operator intervention, and automated recovery event.
model RiskEscalationEvent {
  id                       String   @id @default(uuid()) @db.Uuid
  alpacaAccountId          String?  @db.Uuid
  /// TYPESTRING.SKIP=true GQL.SKIP=true
  alpacaAccount            AlpacaAccount? @relation(fields: [alpacaAccountId], references: [id], onDelete: SetNull)

  scopeKind                String
  scopeValue               String?

  fromState                String
  toState                  String
  reason                   RiskEscalationReason
  severity                 OverlaySeverity

  triggeringObserver       String?
  observedValue            Decimal? @db.Decimal(20, 6)
  breachedThreshold        Decimal? @db.Decimal(20, 6)
  breachedThresholdKey     String?

  correlationId            String?
  triggeringEventId        String?
  actor                    RiskEscalationActor
  actorUserId              String?
  rationale                String?

  /// Back-reference: the overlay this event activated (FK owned by PolicyOverlay.riskEscalationEventId). TYPESTRING.SKIP=true GQL.SKIP=true
  activatedPolicyOverlay      PolicyOverlay? @relation("PolicyOverlayActivatedBy")

  triggeredByPolicyOverlayId  String?  @db.Uuid
  /// TYPESTRING.SKIP=true GQL.SKIP=true
  triggeredByPolicyOverlay    PolicyOverlay? @relation("PolicyOverlayTriggeredEvents", fields: [triggeredByPolicyOverlayId], references: [id])

  createdAt                DateTime @default(now())

  @@index([alpacaAccountId, createdAt])
  @@index([scopeKind, scopeValue, createdAt])
  @@index([reason, severity, createdAt])
  @@index([correlationId])
  @@index([triggeredByPolicyOverlayId])
}

// ============================================================================
// Organization → Fund → BrokerageAccount tenancy layer (SP2-A, 2026-07-02).
// Strictly additive over the canonical User → AlpacaAccount ownership chain:
// AlpacaAccount and TradingPolicy remain untouched and canonical, and the
// engine keeps consuming them unchanged via adaptic.* on the 0.0.x lineage.
// BrokerageAccount bridges to the engine via engineAccountId; for ALPACA
// accounts the backfill invariant is id = engineAccountId = alpaca_accounts.id.
// ============================================================================

// Brokerage provider backing a fund-owned BrokerageAccount.
enum BrokerageProvider {
  /// Alpaca Markets — the only provider bridged to the engine today.
  ALPACA

  /// Interactive Brokers — reserved for engine multi-broker support.
  IBKR

  /// Coinbase — reserved for engine multi-broker crypto support.
  COINBASE
}

// Environment type of a brokerage account (value-compatible with AlpacaAccountType).
enum BrokerageAccountType {
  /// A simulated trading account for testing strategies without real money.
  PAPER

  /// A live trading account with real funds.
  LIVE
}

// Lifecycle status of a Fund. Values mirror the platform FundStatus contract
// (platform packages/database/src/types/fund.ts); operative traffic filters on ACTIVE.
enum FundStatus {
  /// Initial setup phase.
  DRAFT

  /// Awaiting regulatory approval.
  PENDING_APPROVAL

  /// Approved and active.
  ACTIVE

  /// Temporarily suspended.
  SUSPENDED

  /// In liquidation process.
  LIQUIDATING

  /// Fully liquidated and closed.
  CLOSED
}

// Role a user holds within an Organization. The platform's org-level RBAC
// lives here (OrgMembership.role), NOT in UserRole — do not extend UserRole.
enum OrgRole {
  /// Full control of the organization, including deletion and billing.
  OWNER

  /// Administrative control short of ownership transfer/deletion.
  ADMIN

  /// Manages portfolios and trading for the organization's funds.
  PORTFOLIO_MANAGER

  /// Oversees regulatory compliance for the organization.
  COMPLIANCE_OFFICER

  /// Handles KYC/AML verification workflows.
  KYC_AML_OFFICER

  /// Read-only audit access across the organization.
  AUDITOR

  /// Baseline membership with no elevated permissions.
  MEMBER
}

// Role a user holds within a specific Fund (FundAssignment.role). Superset of
// the platform FundRole contract and the 2026-03-10 fund-centric design roles.
enum FundRole {
  /// Full control over the fund: trading, configuration, investor management.
  MANAGER

  /// Executes trades within the fund's policy limits.
  TRADER

  /// Read-only access to fund data, positions, and analytics.
  ANALYST

  /// Compliance oversight scoped to this fund.
  COMPLIANCE

  /// Read-only audit access scoped to this fund.
  AUDITOR

  /// Read-only access to fund summary and NAV.
  VIEWER

  /// Investor-facing access: holdings, NAV, documents.
  INVESTOR
}

// Top-level tenancy unit that owns funds. Users belong to organizations via OrgMembership.
model Organization {
  /// Unique identifier for the organization. TYPESTRING.SKIP=true
  id String @id @default(uuid()) @db.Uuid

  /// Organization display name.
  name String

  /// URL-safe unique slug identifying the organization.
  slug String @unique

  /// URL of the organization's logo image. TYPESTRING.SKIP=true
  logoUrl String?

  /// The organization's website URL. TYPESTRING.SKIP=true
  website String?

  /// Business structure ('fund_operator' | 'family_office'); lowercase String to match the platform contract.
  businessType String?

  /// Email domains associated with this organization for domain-based member matching. TYPESTRING.SKIP=true
  emailDomains String[] @default([])

  /// Jurisdiction country code (ISO 3166-1 alpha-2).
  jurisdiction String?

  /// Regulatory registration status ('registered' | 'exempt' | 'pending_registration' | 'not_applicable'); lowercase String to match the platform contract.
  regulatoryStatus String?

  /// Brief description of the organization.
  description String?

  /// Default trading settings applied to all funds in this organization (JSON; per-fund overrides live in Fund.tradingOverrides). TYPESTRING.SKIP=true
  tradingDefaults Json?

  /// Memberships linking users to this organization. TYPESTRING.SKIP=true GQL.EXCLUDE=['organization']
  members OrgMembership[]

  /// Funds owned by this organization. TYPESTRING.SKIP=true GQL.EXCLUDE=['organization']
  funds Fund[]

  /// Investors belonging to this organization. TYPESTRING.SKIP=true GQL.SKIP=true
  investors Investor[]

  /// Investor-relations documents scoped to this organization. TYPESTRING.SKIP=true GQL.SKIP=true
  investorDocuments InvestorDocument[]

  /// Investor tax documents scoped to this organization. TYPESTRING.SKIP=true GQL.SKIP=true
  taxDocuments TaxDocument[]

  /// Notification events scoped to this organization. TYPESTRING.SKIP=true GQL.SKIP=true
  notificationEvents NotificationEvent[]

  /// Governance mandates owned by this organization (org-scoped mandates plus the roll-up of its fund-scoped mandates); read via adaptic.mandate.* rather than through the org to avoid pulling the version/rules tree on every org read. TYPESTRING.SKIP=true GQL.SKIP=true
  mandates Mandate[]

  /// Timestamp when the organization was created. TYPESTRING.SKIP=true
  createdAt DateTime @default(now())

  /// Timestamp when the organization was last updated. TYPESTRING.SKIP=true
  updatedAt DateTime @updatedAt

  /// Timestamp when the organization was soft-deleted. Null means the record is active. TYPESTRING.SKIP=true
  deletedAt DateTime?

  @@map(name: "organizations")
}

// Links a user to an organization with an org-level role and granular permissions.
model OrgMembership {
  /// Unique identifier for the membership. TYPESTRING.SKIP=true
  id String @id @default(uuid()) @db.Uuid

  /// Foreign key referencing the Organization. TYPESTRING.SKIP=true
  organizationId String @db.Uuid

  /// Relation to the Organization model. TYPESTRING.INCLUDE=['id','name','slug'] GQL.EXCLUDE=['members','funds']
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Foreign key referencing the User. TYPESTRING.SKIP=true
  userId String @db.Uuid

  /// Relation to the User model. TYPESTRING.INCLUDE=['id','name','email'] GQL.INCLUDE=['id','name','email','image']
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Role the user holds within the organization.
  role OrgRole @default(MEMBER)

  /// Granular permissions granted to this member. TYPESTRING.SKIP=true
  permissions String[] @default([])

  /// Timestamp when the membership was created. TYPESTRING.SKIP=true
  createdAt DateTime @default(now())

  /// Timestamp when the membership was last updated. TYPESTRING.SKIP=true
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@map(name: "org_memberships")
}

// A fund owned by an organization. Owns brokerage accounts and carries the
// per-fund trading overrides merged over Organization.tradingDefaults.
model Fund {
  /// Unique identifier for the fund. TYPESTRING.SKIP=true
  id String @id @default(uuid()) @db.Uuid

  /// Fund display name.
  name String

  /// URL-safe slug, unique within the owning organization.
  slug String

  /// Brief description of the fund.
  description String?

  /// Lifecycle status of the fund.
  status FundStatus @default(DRAFT)

  /// Base currency of the fund (ISO 4217 code).
  currency String @default("USD")

  /// Foreign key referencing the owning Organization. TYPESTRING.SKIP=true
  organizationId String @db.Uuid

  /// Relation to the owning Organization. TYPESTRING.INCLUDE=['id','name','slug'] GQL.INCLUDE=['id','name','slug']
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Foreign key referencing the managing User. TYPESTRING.SKIP=true
  managerId String? @db.Uuid

  /// Relation to the User who manages this fund. TYPESTRING.SKIP=true GQL.INCLUDE=['id','name','email']
  manager User? @relation("FundManager", fields: [managerId], references: [id], onDelete: SetNull)

  /// Foreign key referencing the operating User. TYPESTRING.SKIP=true
  operatorId String? @db.Uuid

  /// Relation to the User who operates this fund. TYPESTRING.SKIP=true GQL.INCLUDE=['id','name','email']
  operator User? @relation("FundOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  /// Date the fund began operations.
  inceptionDate DateTime?

  /// Assets under management in the fund's base currency.
  aum Float @default(0)

  /// Net asset value per share/unit.
  navPerShare Float @default(1)

  /// Total shares/units outstanding.
  sharesOutstanding Float @default(0)

  /// High-water-mark NAV used for performance-fee calculation.
  highWaterMarkNav Float?

  /// Fee structure (management/performance fees; JSON). TYPESTRING.SKIP=true
  fees Json?

  /// Fund terms (lockup, redemption windows, minimums; JSON). TYPESTRING.SKIP=true
  terms Json?

  /// Regulatory metadata (jurisdiction, exemptions, sharia compliance; JSON). TYPESTRING.SKIP=true
  regulatory Json?

  /// Service providers (administrator, custodian, auditor; JSON). TYPESTRING.SKIP=true
  serviceProviders Json?

  /// Per-fund overrides of Organization.tradingDefaults (JSON). TYPESTRING.SKIP=true
  tradingOverrides Json?

  /// Brokerage accounts owned by this fund. TYPESTRING.SKIP=true GQL.EXCLUDE=['fund']
  brokerageAccounts BrokerageAccount[]

  /// User assignments for this fund. TYPESTRING.SKIP=true GQL.SKIP=true
  assignments FundAssignment[]

  /// Per-investor holdings (capital accounts) in this fund. TYPESTRING.SKIP=true GQL.SKIP=true
  holdings Holding[]

  /// Investor capital-ledger transactions for this fund. TYPESTRING.SKIP=true GQL.SKIP=true
  investorTransactions InvestorTransaction[]

  /// Investor-relations documents scoped to this fund. TYPESTRING.SKIP=true GQL.SKIP=true
  investorDocuments InvestorDocument[]

  /// Investor tax documents scoped to this fund. TYPESTRING.SKIP=true GQL.SKIP=true
  taxDocuments TaxDocument[]

  /// Notification events scoped to this fund. TYPESTRING.SKIP=true GQL.SKIP=true
  notificationEvents NotificationEvent[]

  /// Governance mandates scoped to this fund; read via adaptic.mandate.* rather than through the fund to avoid pulling the version/rules tree on every fund read. TYPESTRING.SKIP=true GQL.SKIP=true
  mandates Mandate[]

  /// Timestamp when the fund was created. TYPESTRING.SKIP=true
  createdAt DateTime @default(now())

  /// Timestamp when the fund was last updated. TYPESTRING.SKIP=true
  updatedAt DateTime @updatedAt

  /// Timestamp when the fund was soft-deleted. Null means the record is active. TYPESTRING.SKIP=true
  deletedAt DateTime?

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([status])
  @@map(name: "funds")
}

// Links a user to a fund with a fund-level role and granular permissions.
model FundAssignment {
  /// Unique identifier for the assignment. TYPESTRING.SKIP=true
  id String @id @default(uuid()) @db.Uuid

  /// Foreign key referencing the Fund. TYPESTRING.SKIP=true
  fundId String @db.Uuid

  /// Relation to the Fund model. TYPESTRING.INCLUDE=['id','name','slug'] GQL.INCLUDE=['id','name','slug','status','organizationId']
  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  /// Foreign key referencing the User. TYPESTRING.SKIP=true
  userId String @db.Uuid

  /// Relation to the User model. TYPESTRING.INCLUDE=['id','name','email'] GQL.INCLUDE=['id','name','email','image']
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Role the user holds within this fund.
  role FundRole @default(VIEWER)

  /// Granular permissions granted for this fund. TYPESTRING.SKIP=true
  permissions String[] @default([])

  /// Timestamp when the assignment was created. TYPESTRING.SKIP=true
  createdAt DateTime @default(now())

  /// Timestamp when the assignment was last updated. TYPESTRING.SKIP=true
  updatedAt DateTime @updatedAt

  @@unique([fundId, userId])
  @@index([userId])
  @@map(name: "fund_assignments")
}

// Fund-owned brokerage account: the platform-facing account entity. For
// ALPACA accounts it bridges 1:1 to the engine-canonical AlpacaAccount via
// engineAccountId (backfill invariant: id = engineAccountId). The policy
// columns mirror AlpacaAccount defaults for the platform policy editor;
// TradingPolicy remains canonical for the engine during the SP2 transition.
model BrokerageAccount {
  /// Unique identifier. For ALPACA accounts this equals engineAccountId (= alpaca_accounts.id) by the backfill invariant. TYPESTRING.SKIP=true
  id String @id @default(uuid()) @db.Uuid

  /// Brokerage provider backing this account.
  provider BrokerageProvider @default(ALPACA)

  /// Account environment (paper or live).
  type BrokerageAccountType @default(PAPER)

  /// Human-friendly display label for the account.
  label String?

  /// Foreign key referencing the owning Fund. TYPESTRING.SKIP=true
  fundId String @db.Uuid

  /// Relation to the owning Fund. TYPESTRING.INCLUDE=['id','name','slug'] GQL.INCLUDE=['id','name','slug','organizationId']
  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  /// Engine-side AlpacaAccount id this account is bridged to (the WS-scoping id). Null for non-ALPACA providers until engine multi-broker support lands. TYPESTRING.SKIP=true
  engineAccountId String? @unique @db.Uuid

  /// Relation to the engine-canonical AlpacaAccount. Never exposed through generated selection sets. TYPESTRING.SKIP=true GQL.SKIP=true
  engineAccount AlpacaAccount? @relation(fields: [engineAccountId], references: [id], onDelete: SetNull)

  /// Provider API key. Never exposed through generated selection sets. TYPESTRING.SKIP=true GQL.SKIP=true
  apiKey String?

