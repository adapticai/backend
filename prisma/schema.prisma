/// DeepInfra-hosted open-weight language models available for text generation.
/// DeepInfra hosts models authored by other organisations, so every id is
/// namespaced "<org>/<model>" and preserves the author's own casing. The wire id
/// is the quoted string below, never the member name: enum members are Postgres
/// and GraphQL identifiers and cannot contain "/" or "." , so the member is the
/// id uppercased with "/", "-" and "." folded to "_". Consumers that need the
/// callable id read the documented string, which is what the free-text
/// model-id columns store.
enum DeepinfraModel {
  /// DeepSeek V4 Pro (flagship; recommended for advanced/complex queries)
  /// API model id: "deepseek-ai/DeepSeek-V4-Pro"
  DEEPSEEK_AI_DEEPSEEK_V4_PRO

  /// DeepSeek V4 Flash (mid-tier; latency-sensitive work)
  /// API model id: "deepseek-ai/DeepSeek-V4-Flash"
  DEEPSEEK_AI_DEEPSEEK_V4_FLASH

  /// DeepSeek V4.1 Flash (newer mid-tier revision)
  /// API model id: "deepseek-ai/DeepSeek-V4.1-Flash"
  DEEPSEEK_AI_DEEPSEEK_V4_1_FLASH

  /// GLM-5.3 (Z.ai flagship open-weight model)
  /// API model id: "zai-org/GLM-5.3"
  ZAI_ORG_GLM_5_3

  /// GLM-5.3 Flash (fast, economical GLM-5.3)
  /// API model id: "zai-org/GLM-5.3-Flash"
  ZAI_ORG_GLM_5_3_FLASH

  /// Kimi K3 (Moonshot open-weight flagship)
  /// API model id: "moonshotai/Kimi-K3"
  MOONSHOTAI_KIMI_K3

  /// gpt-oss 120B (OpenAI open-weight; larger tier)
  /// API model id: "openai/gpt-oss-120b"
  OPENAI_GPT_OSS_120B

  /// gpt-oss 20B (OpenAI open-weight; smaller, cheaper tier)
  /// API model id: "openai/gpt-oss-20b"
  OPENAI_GPT_OSS_20B

  /// Ling 3.0 flash Fin (finance-tuned; fast tier)
  /// API model id: "inclusionAI/Ling-3.0-flash-Fin"
  INCLUSIONAI_LING_3_0_FLASH_FIN

  /// Nemotron 3 Nano 30B A3B (NVIDIA; small mixture-of-experts)
