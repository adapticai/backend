// ============================================================================
// Notification pipeline (SP3 W4-N, 2026-07-02).
// System-of-record models for the triggered email/push/in-app pipeline:
// trigger source → durable NotificationEvent → platform dispatcher
// (audience resolution + NotificationPreference) → renderer/provider adapter →
// NotificationDelivery audit rows. Strictly additive. Catalog channel defaults
// and `always:true` locks are resolved in the dispatcher service layer at
// dispatch time from the 88-entry notification catalog — they are intentionally
// NOT materialised as preference rows here.
// ============================================================================

// Delivery channel for a notification (mirrors the catalog's email/push/inapp channel set).
enum NotificationChannel {
  /// Rendered email sent through the platform provider adapter (Resend primary).
  EMAIL

  /// Native/web push notification.
  PUSH

  /// In-app notification-feed entry (bell / Notification Center).
  IN_APP
}

// Lifecycle status of a single recipient×channel notification delivery.
enum NotificationDeliveryStatus {
  /// Fan-out row created; not yet handed to a provider.
  PENDING

  /// Accepted by the provider (or written to the in-app feed).
  SENT

  /// Provider confirmed delivery (e.g. Resend/SES delivery webhook).
  DELIVERED

  /// Provider reported a hard bounce.
  BOUNCED

  /// Dispatcher or provider failed permanently after retries.
  FAILED

  /// Suppressed before send (preference opt-out, suppression list, or policy).
  SUPPRESSED
}

// Durable, idempotent record of a notification-worthy domain event. Written by
// trigger sources (engine via adaptic.*, platform actions, schedulers, billing
// webhooks); consumed by the platform dispatcher, which fans out one
// NotificationDelivery per recipient×channel. Rows are append-only.
model NotificationEvent {
  /// Unique identifier for the notification event. TYPESTRING.SKIP=true
  id String @id @default(uuid()) @db.Uuid

  /// Notification-catalog event id this event instantiates (e.g. 'risk_limit_breach'). Not a foreign key — the 88-entry catalog lives in platform code.
  eventId String

  /// Foreign key referencing the scoping Organization, when the event is org-scoped. TYPESTRING.SKIP=true
  orgId String? @db.Uuid

  /// Relation to the scoping Organization. TYPESTRING.SKIP=true GQL.INCLUDE=['id','name','slug']
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  /// Foreign key referencing the scoping Fund, when the event is fund-scoped. TYPESTRING.SKIP=true
  fundId String? @db.Uuid

  /// Relation to the scoping Fund. TYPESTRING.SKIP=true GQL.INCLUDE=['id','name','slug']
  fund Fund? @relation(fields: [fundId], references: [id], onDelete: SetNull)

  /// ID of the user whose action produced the event, when user-initiated. Plain scalar (no relation) per the AuditLog.userId convention so event rows survive user deletion. TYPESTRING.SKIP=true
  actorUserId String? @db.Uuid

  /// Template payload for the catalog event (typed per eventId in the platform spec registry; JSON).
  payload Json

  /// Producer-supplied idempotency key; the UNIQUE constraint makes event writes exactly-once under trigger retries. TYPESTRING.SKIP=true
  idempotencyKey String @unique

  /// Trigger source that produced the event ('engine' | 'platform' | 'scheduler' | 'billing'); lowercase String to match the platform contract.
  source String

  /// Deliveries fanned out from this event. TYPESTRING.SKIP=true GQL.SKIP=true
  deliveries NotificationDelivery[]

  /// Timestamp when the event was recorded. TYPESTRING.SKIP=true
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([orgId])
  @@index([fundId])
  @@map(name: "notification_events")
}

// SOC2 delivery-audit record: one row per recipient×channel fan-out of a
// NotificationEvent, updated by the dispatcher and provider delivery webhooks
// (delivered/bounced/complained). Together with AuditLog this is the evidence
// trail proving what was sent, to whom, with which template version.
model NotificationDelivery {
  /// Unique identifier for the delivery. TYPESTRING.SKIP=true
  id String @id @default(uuid()) @db.Uuid

  /// Foreign key referencing the NotificationEvent this delivery fans out from. TYPESTRING.SKIP=true
  eventId String @db.Uuid

  /// Relation to the source NotificationEvent. TYPESTRING.INCLUDE=['id','eventId','source'] GQL.INCLUDE=['id','eventId','payload','source','createdAt']
  event NotificationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Foreign key referencing the recipient User. TYPESTRING.SKIP=true
  recipientUserId String @db.Uuid

  /// Relation to the recipient User. Cascade keeps erasure complete when a user row is hard-deleted (users are soft-deleted in normal operation). TYPESTRING.INCLUDE=['id','name','email'] GQL.INCLUDE=['id','name','email']
  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  /// Channel this delivery targets.
  channel NotificationChannel

  /// Template id used to render the notification (catalog id; equals event.eventId unless a variant was selected).
  templateId String

  /// Version of the template at render time (SOC2: proves exactly what was rendered and sent).
  templateVersion String

  /// Delivery provider selected by the dispatcher ('resend' | 'ses' | 'apns' | 'fcm' | 'inapp'); lowercase String, null until dispatch.
  provider String?

  /// Provider-side message id used to correlate delivery/bounce webhooks. TYPESTRING.SKIP=true
  providerMessageId String?

  /// Lifecycle status of the delivery.
  status NotificationDeliveryStatus @default(PENDING)

  /// Human-readable detail for the current status (bounce reason, suppression cause, provider error). TYPESTRING.SKIP=true
  statusDetail String?

  /// Timestamp when the provider accepted the message. TYPESTRING.SKIP=true
  sentAt DateTime?

  /// Timestamp when the provider confirmed delivery. TYPESTRING.SKIP=true
  deliveredAt DateTime?

  /// Timestamp when the recipient read the notification (IN_APP feed read-state; null = unread). Dedicated column so read-state is not overloaded onto the DELIVERED delivery status; the platform feed adopts this later. TYPESTRING.SKIP=true
  readAt DateTime?

  /// Timestamp when the delivery row was created. TYPESTRING.SKIP=true
  createdAt DateTime @default(now())

  /// Timestamp when the delivery row was last updated (status transitions from dispatcher/webhooks). TYPESTRING.SKIP=true
  updatedAt DateTime @updatedAt

  @@unique([eventId, recipientUserId, channel])
  @@index([recipientUserId, createdAt])
  @@index([status])
  @@index([providerMessageId])
  @@map(name: "notification_deliveries")
}

// Per-user notification preference: one row per user×catalog-event×channel
// override. Absence of a row means the catalog channel default applies;
// `always:true` catalog locks (required/security emails) are enforced in the
// dispatcher service layer — a row here can never disable them.
model NotificationPreference {
  /// Unique identifier for the preference. TYPESTRING.SKIP=true
  id String @id @default(uuid()) @db.Uuid

  /// Foreign key referencing the User. TYPESTRING.SKIP=true
  userId String @db.Uuid

  /// Relation to the User model. TYPESTRING.INCLUDE=['id','name','email'] GQL.INCLUDE=['id','name','email']
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Notification-catalog event id this preference applies to (e.g. 'risk_limit_breach').
  eventId String

  /// Channel this preference applies to.
  channel NotificationChannel

  /// Whether the user has this event×channel enabled.
  enabled Boolean

  /// Timestamp when the preference was created. TYPESTRING.SKIP=true
  createdAt DateTime @default(now())

  /// Timestamp when the preference was last updated. TYPESTRING.SKIP=true
  updatedAt DateTime @updatedAt

  @@unique([userId, eventId, channel])
  @@map(name: "notification_preferences")
}

// ============================================================================
// Investor Relations (IR) domain
// Investor capital accounts, per-fund holdings, capital-ledger transactions,
// and IR / tax documents. Consumed by the engine IR REST layer and the
// platform investor-relations surfaces.
// ============================================================================

enum InvestorType {
  /// A single natural person.
  INDIVIDUAL

  /// A jointly-held individual account.
  JOINT

  /// A legal entity (LLC, corporation, partnership).
  ENTITY

  /// An institutional allocator (pension, endowment, fund-of-funds).
  INSTITUTION

  /// A trust vehicle.
  TRUST

  /// A tax-advantaged retirement account (IRA, 401k).
  RETIREMENT_ACCOUNT
}

enum InvestorKycStatus {
  /// KYC not yet started or awaiting documents.
  PENDING

  /// KYC submitted and under review.
  REVIEW

  /// KYC approved; the investor may transact.
  APPROVED

  /// KYC rejected; the investor is blocked from transacting.
  REJECTED
}

enum InvestorStatus {
  /// Identified but not yet onboarding.
  PROSPECT

  /// In the onboarding / subscription-agreement process.
  ONBOARDING

  /// Active investor with (or eligible for) holdings.
  ACTIVE

  /// Temporarily inactive (no active holdings, relationship retained).
  INACTIVE

  /// Fully redeemed and closed.
  CLOSED
}

enum HoldingStatus {
  /// The investor currently holds units in the fund.
  ACTIVE

  /// The position has been fully redeemed and closed.
  CLOSED
}

enum InvestorTransactionType {
  /// Capital into the fund (units issued).
  SUBSCRIPTION

  /// Capital out of the fund (units redeemed).
  REDEMPTION

  /// A drawdown notice against a committed amount.
  CAPITAL_CALL

  /// A cash distribution paid to the investor.
  DISTRIBUTION

  /// A transfer of units between investors.
  TRANSFER

  /// A fee charged to the investor (management/performance).
  FEE
}

enum InvestorTransactionStatus {
  /// Requested; awaiting operator review.
  PENDING

  /// Under operator review.
  REVIEWING

  /// Approved; awaiting execution at the next NAV strike.
  APPROVED

  /// Execution in progress.
  PROCESSING

  /// Executed at NAV; units issued/redeemed.
  COMPLETED

  /// Cash settled with the investor.
  SETTLED

  /// Rejected by the operator (see rejectionReason).
  REJECTED

  /// Cancelled by the investor or operator before execution.
  CANCELLED

  /// Execution failed after approval.
  FAILED
}

enum InvestorDocumentType {
  /// Periodic capital-account statement.
  STATEMENT

  /// Periodic investor report (quarterly/annual letter).
  REPORT

  /// Subscription agreement.
  SUBSCRIPTION_AGREEMENT

  /// Offering memorandum / private-placement memorandum.
  OFFERING_MEMORANDUM

  /// Capital-call notice.
  CAPITAL_CALL_NOTICE

  /// Distribution notice.
  DISTRIBUTION_NOTICE

  /// KYC/AML documentation.
  KYC

  /// Tax-related document (see TaxDocument for structured tax forms).
  TAX

  /// Any other investor-relations document.
  OTHER
}

enum InvestorDocumentStatus {
  /// Drafted but not yet published to investors.
  DRAFT

  /// Published and available to the investor.
  AVAILABLE

  /// Archived / superseded.
  ARCHIVED
}

enum TaxDocumentType {
  /// Schedule K-1 (partnership).
  K1

  /// Form 1099 series.
  FORM_1099

  /// Form 1042-S (foreign persons' US-source income).
  FORM_1042S

  /// Form 8949 (sales and dispositions of capital assets).
  FORM_8949

  /// Consolidated annual tax summary.
  ANNUAL_SUMMARY

  /// Any other tax document.
  OTHER
}

enum TaxDocumentStatus {
  /// Not yet issued (in preparation).
  PENDING

  /// Issued and available to the investor.
  AVAILABLE

  /// Amended after original issuance.
  AMENDED

  /// Superseded by a later version.
  SUPERSEDED
}

